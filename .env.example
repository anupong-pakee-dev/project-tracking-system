# ============================================================================
#  Project Tracker — every environment variable, in one place
# ============================================================================
#  This file is a REFERENCE. Nothing reads a .env at the repo root.
#  Each app loads its own file:
#
#    apps/api/.env          ← section 1   (template: apps/api/.env.example)
#    apps/web/.env.local    ← section 2   (template: apps/web/.env.example)
#
#  Quick start (creates both files and a matching API_TOKEN):
#    npm run setup:env
#
#  On Vercel: put section 1 in the API project and section 2 in the web project
#  (Project → Settings → Environment Variables). See docs/DEPLOY.md.
#  Ready-to-fill production files (gitignored, paste into Vercel as a whole):
#    apps/api/.env.vercel   → tracker-api        apps/web/.env.vercel   → tracker-web
#
#  [required]  must be set      [prod]  required in production only      [optional]  has a default
# ============================================================================


# ----------------------------------------------------------------------------
# 1. apps/api/.env — backend (Fastify + Prisma)
# ----------------------------------------------------------------------------

# [required] PostgreSQL connection used at runtime.
#   Local:      Docker Postgres from docker-compose.yml (npm run dev starts it)
#   Production: the POOLED url — Neon "Pooled connection" / Supabase "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker"

# [optional] Direct (non-pooled) url, used only by migrations. Falls back to
#   DATABASE_URL_UNPOOLED (set automatically by Vercel's Neon integration), then DATABASE_URL.
#   Production: Neon with pooling off / Supabase "Session pooler" (port 5432)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# [optional] Max database connections per instance. Default 10 locally, 5 on Vercel.
# DB_POOL_MAX=5

# [prod] Shared secret: apps/web must send the same value. 32+ characters in production.
#   Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
API_TOKEN=

# [prod] Public URL of the web app — links in verification / reset emails point here.
#   Production: https://… (the API refuses to start with http in production)
APP_URL=http://localhost:3000

# [prod] SMTP server for outgoing email.
#   Local:      Mailpit from docker-compose — read mail at http://localhost:8025
#   Production: e.g. Resend  smtps://resend:<API_KEY>@smtp.resend.com:465
#               or Gmail     smtps://you%40gmail.com:<APP_PASSWORD>@smtp.gmail.com:465
SMTP_URL=smtp://localhost:1025

# [optional] Sender shown on emails. Production: use an address on your verified domain.
MAIL_FROM="Project Tracker <no-reply@tracker.local>"

# [optional] Time zone that decides what "today" is (servers like Vercel run on UTC).
APP_TIMEZONE=Asia/Bangkok

# [optional] Google sign-in — set both or neither (neither = no "Continue with Google" button).
#   Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Web application"
#   Authorized redirect URI:  <APP_URL>/auth/google/callback
#     Local:      http://localhost:3000/auth/google/callback
#     Production: https://<your-web>.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [optional] Where the API listens locally (ignored on Vercel).
API_HOST=127.0.0.1
API_PORT=4000

# [optional] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# [optional] Database for integration tests — migrated and WIPED on every `npm test`.
#   Never point it at real data. Unset = API integration tests are skipped.
TEST_DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker_test"

# [optional, Vercel only] Migrations run automatically on production deploys. Set to 1 on a
#   preview environment that has its OWN database to migrate it too.
# RUN_MIGRATIONS=1


# ----------------------------------------------------------------------------
# 2. apps/web/.env.local — frontend (Next.js)
# ----------------------------------------------------------------------------

# [prod] Where the API is reachable (server-side only — never sent to the browser).
#   Local default: http://127.0.0.1:4000     Production: https://<your-api>.vercel.app
API_URL=http://127.0.0.1:4000

# [prod] Must be IDENTICAL to API_TOKEN in section 1.
API_TOKEN=

# [optional] Keep the same as APP_TIMEZONE in section 1.
APP_TIMEZONE=Asia/Bangkok


# ----------------------------------------------------------------------------
# Set automatically — do not define these yourself
# ----------------------------------------------------------------------------
#   NODE_ENV     "production" for `npm run build` / `npm start` and on Vercel
#   VERCEL       set on Vercel; switches on serverless DB pooling and production checks
#   VERCEL_ENV   production | preview | development — decides whether migrations run
