# Copy to apps/api/.env

# ---- PostgreSQL ----
# Option A — local development (default): Docker Postgres from docker-compose.yml.
#   Start it with `npm run db:up` (npm run dev also starts it automatically).
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker"

# Option B — Supabase / Neon:
#   DATABASE_URL = POOLED url    (Supabase: Connect → "Transaction pooler", port 6543 · Neon: "Pooled connection")
#   DIRECT_URL   = DIRECT url for migrations (Supabase: "Session pooler", port 5432 · Neon: pooling off)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Max pooled connections (default 10). Lower it if your plan limits connections.
# DB_POOL_MAX=5

# Integration tests run migrations on this database and WIPE it on every `npm test`.
# Never point it at real data. Leave unset to skip the API integration tests.
TEST_DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker_test"

# ---- Email (verify email, reset password) ----
# Public URL of the web app — links in emails point here.
APP_URL=http://localhost:3000
# Local: Mailpit from docker-compose (read mail at http://localhost:8025).
# Production: your provider's SMTP, e.g. smtps://USER:PASSWORD@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Project Tracker <no-reply@tracker.local>"

# ---- Google sign-in (optional) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID ("Web application").
# Authorized redirect URI: <APP_URL>/auth/google/callback  (locally http://localhost:3000/auth/google/callback)
# Leave both empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Time zone that decides what "today" is (servers like Vercel run on UTC).
APP_TIMEZONE=Asia/Bangkok

# ---- API server ----
API_HOST=127.0.0.1
API_PORT=4000
# Shared secret between apps/web and apps/api. Set the same value in apps/web/.env.local.
# Required in production (32+ chars). Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
API_TOKEN=
LOG_LEVEL=info

# ---- Vercel only ----
# Migrations run automatically on production deploys. Set to 1 on a preview environment that
# has its OWN database to migrate it too.
# RUN_MIGRATIONS=1
