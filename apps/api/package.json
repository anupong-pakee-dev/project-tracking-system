{
  "name": "@tracker/api",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import-json": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-json.ts",
    "db:recover": "node --disable-warning=ExperimentalWarning scripts/recover-from-branch.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tracker/shared": "*",
    "@vercel/functions": "^3.9.9",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "prisma": "7.10.0",
    "vitest": "^5.0.3"
  }
}
