# Where apps/api is listening (server-side only — never exposed to the browser).
API_URL=http://127.0.0.1:4000
# Must match API_TOKEN in apps/api/.env. Required in production; locally you may leave both empty.
API_TOKEN=
# Time zone that decides what "today" is (servers like Vercel run on UTC). Keep in sync with apps/api.
APP_TIMEZONE=Asia/Bangkok
